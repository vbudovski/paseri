{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "license": "MIT",
  "imports": {
    "@astrojs/check": "npm:@astrojs/check@^0.9.10",
    "@astrojs/markdown-satteri": "npm:@astrojs/markdown-satteri@^0.4.1",
    "@astrojs/preact": "npm:@astrojs/preact@^6.0.5",
    "@astrojs/sitemap": "npm:@astrojs/sitemap@^3.7.4",
    "@astrojs/starlight": "npm:@astrojs/starlight@^0.42.0",
    "@preact/signals": "npm:@preact/signals@^2.11.2",
    "@preact/signals-core": "npm:@preact/signals-core@^1.14.4",
    "astro": "npm:astro@^7.3.2",
    "charts.css": "npm:charts.css@^1.2.0",
    "codejar": "npm:codejar@^4.3.0",
    "preact": "npm:preact@^10.29.8",
    "sugar-high": "npm:sugar-high@^2.3.1",
    "rollup-plugin-visualizer": "npm:rollup-plugin-visualizer@^7.1.1",
    "satteri": "npm:satteri@^0.10.5",
    "satteri-external-links": "npm:satteri-external-links@^0.1.1",
    "sharp": "npm:sharp@^0.35.4",
    "typescript": "npm:typescript@^6.0.3",
    "zod": "npm:zod@^4.5.4"
  },
  "tasks": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "exclude": [".astro", "dist", "src/env.d.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "isolatedDeclarations": false,
    "exactOptionalPropertyTypes": false
  }
}
